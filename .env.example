# Copy to .env and fill in the provider you use. Never commit the real file.
# Keys are read from the environment first, then from this file, then from the
# credentials written by `chinchilla settings`.

# Provider "openai"
# OPENAI_API_KEY=sk-...

# Provider "anthropic"
# ANTHROPIC_API_KEY=sk-ant-...

# Provider "openrouter"
# OPENROUTER_API_KEY=sk-or-...

# Provider "custom": any OpenAI compatible endpoint
# LLM_BASE_URL=https://your-host/v1
# LLM_MODEL=your-model
# LLM_API_KEY=...

# Web search (optional). Only needed when npx or Chrome are outside PATH or in
# a non default location; `chinchilla doctor` prints what it resolved.
# WEBSEARCH_MCP_COMMAND=/home/you/.local/node/bin/npx
# WEBSEARCH_MCP_ARGS=-y dsh-google-chrome-search mcp
# CHROME_PATH=/usr/bin/google-chrome
# macOS: CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# GSEARCH_PROFILE=/home/you/.dsh-chrome-google